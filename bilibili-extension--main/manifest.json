{
  "manifest_version": 3,
  "name": "B站数据爬取工具",
  "version": "2.0.1",
  "description": "一键获取B站视频的弹幕、评论和字幕",
  "permissions": ["storage", "downloads", "activeTab", "tabs", "cookies", "contextMenus", "notifications"],
  "host_permissions": ["*://*.bilibili.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站爬虫",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  }
}

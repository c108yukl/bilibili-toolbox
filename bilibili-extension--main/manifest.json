{
  "manifest_version": 3,
  "name": "B站数据爬取工具",
  "version": "2.3.0",
  "description": "一键获取B站视频的弹幕、评论、字幕（AI总结·热词·批量·悬浮球）",
  "permissions": ["storage", "downloads", "activeTab", "tabs", "cookies", "contextMenus", "notifications"],
  "host_permissions": ["*://*.bilibili.com/*", "*://*.hdslb.com/*", "http://127.0.0.1/*", "ws://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站爬虫",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
